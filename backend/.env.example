# ── SQL Server (IDLC) — source of truth, read-only ───────────────────
# DB_SERVER_IDLC: use host.docker.internal to reach SQL Server on your host.
DB_SERVER_IDLC=servername
DB_DATABASE_IDLC=database
DB_USERNAME_IDLC=username
DB_PASSWORD_IDLC=password
DB_PORT_IDLC=1433

# ── PostgreSQL — local warehouse, fully replaced each sync ───────────
POSTGRES_DB=DevAnalyticsDB
POSTGRES_USER=devuser
POSTGRES_PASSWORD=password

# Host port for inspecting the DB from your machine (DBeaver etc.).
# Compose maps <host>:5432. The API always talks to 5432 inside the
# Docker network, so this does NOT affect the app's connection.
POSTGRES_PORT=5432

# Only override if the app runs OUTSIDE Docker (e.g. a script on your
# laptop reaching the mapped port). Inside compose, leave as `db`.
# POSTGRES_HOST=db
# POSTGRES_INTERNAL_PORT=5432
